@callback(
    [Output('opt-optimizer-graph', 'figure'),
     Output('opt-cluster-review-graph', 'figure'),
     Output('opt-tier-filter', 'options'),
     Output('opt-required-tiers', 'options'),
     Output('opt-tier-warning', 'children'),
     Output('optimizer-no-data-warning', 'children')],
    [Input('opt-daytime-hours-slider', 'value'),
     Input('opt-nighttime-max-runs-slider', 'value'),
     Input('opt-current-days-slider', 'value'),
    Input('opt-score-weight-coins', 'value'),
    Input('opt-score-weight-cells', 'value'),
    Input('opt-score-weight-shards', 'value'),
     Input('opt-tier-filter', 'value'),
     Input('opt-required-tiers', 'value'),
     Input('opt-tournament-runs', 'value'),
     Input('opt-tournament-tier', 'value'),
     Input('opt-cluster-review-period', 'value'),
     Input('opt-cluster-review-weighted', 'value'),
     Input('user-json-store', 'data')]
)
def update_optimizer(daytime_hours, nighttime_max_runs, current_days, score_weight_coins, score_weight_cells,
                     score_weight_shards, tier_filter, required_tiers, tournament_runs, tournament_tier,
                     cluster_review_days, cluster_review_weighted, user_json_state):
    """Update optimizer visualization based on settings."""
    cluster_review_days = int(cluster_review_days or 14)
    
    # Get data from store
    optimizer_df = user_data_store.cleaned.get('grouped_by_tier_df', pd.DataFrame())
    filtered_df = user_data_store.cleaned.get('filtered_df', pd.DataFrame())  # For clustering only
    time_series_df = user_data_store.cleaned.get('time_series_df', pd.DataFrame())
    all_runs_time_series_df = user_data_store.cleaned.get('all_runs_time_series_df', pd.DataFrame())
    
    # Perform on-demand clustering with selected review period (for cluster review graph only)
    from functions.statistics.ClusterDetection import detect_clusters
    cluster_df, cluster_stats = detect_clusters(filtered_df, cluster_review_days=cluster_review_days)
    
    # Build tier options from optimizer data
    tier_options = build_tier_options(optimizer_df)
    
    # Check if we have data
    if optimizer_df.empty:
        warning = html.Div(
            'No optimizer data loaded. Please check that your userData.json is present and contains farming/overnight run data.',
            style={'color': '#f97316', 'background': '#222', 'padding': '1rem', 'marginBottom': '1rem', 'borderRadius': '6px'}
        )
        return go.Figure(), tier_options, tier_options, None, warning
    
    # Apply tier filter if specified
    df_to_optimize = optimizer_df.copy()
    if tier_filter and len(tier_filter) > 0:
        tier_filter_int = [int(t) for t in tier_filter]
        df_to_optimize = df_to_optimize[df_to_optimize['tier'].isin(tier_filter_int)]
        
        if df_to_optimize.empty:
            warning = html.Div(
                f'No data available for filtered tiers: {tier_filter}',
                style={'color': '#f97316', 'background': '#222', 'padding': '1rem', 'borderRadius': '6px'}
            )
            return go.Figure(), tier_options, tier_options, warning, None
    
    # Recompute optimizer_score with custom weights (optimizer-only)
    def _safe_max(series: pd.Series) -> float:
        try:
            val = float(series.max())
            return 0.0 if pd.isna(val) else val
        except Exception:
            return 0.0

    if not df_to_optimize.empty:
        weights = [float(score_weight_coins or 0.0), float(score_weight_cells or 0.0), float(score_weight_shards or 0.0)]
        weight_sum = sum(weights)
        if weight_sum <= 0:
            weights = [1/3, 1/3, 1/3]
            weight_sum = 1.0
        w_coins, w_cells, w_shards = [w / weight_sum for w in weights]

        mean_rows = df_to_optimize[df_to_optimize.get('level_1') == 'mean'] if 'level_1' in df_to_optimize.columns else df_to_optimize
        max_coins_per_hour = _safe_max(mean_rows.get('coins_per_hour', pd.Series([0.0])))
        max_cells_per_hour = _safe_max(mean_rows.get('cells_per_hour', pd.Series([0.0])))
        max_shards_per_hour = _safe_max(mean_rows.get('reroll_shards_per_hour', pd.Series([0.0])))

        denom_coins = max_coins_per_hour * 24 if max_coins_per_hour else _safe_max(mean_rows.get('coins_earned', pd.Series([0.0])))
        denom_cells = max_cells_per_hour * 24 if max_cells_per_hour else _safe_max(mean_rows.get('cells_earned', pd.Series([0.0])))
        denom_shards = max_shards_per_hour * 24 if max_shards_per_hour else _safe_max(mean_rows.get('reroll_shards_earned', pd.Series([0.0])))

        def _safe_norm(series: pd.Series, denom: float) -> pd.Series:
            if denom and not pd.isna(denom):
                return series / denom
            return pd.Series([0.0] * len(series), index=series.index)

        df_to_optimize = df_to_optimize.copy()
        df_to_optimize['optimizer_score'] = (
            _safe_norm(df_to_optimize.get('coins_earned', pd.Series([0.0])), denom_coins) * w_coins
            + _safe_norm(df_to_optimize.get('cells_earned', pd.Series([0.0])), denom_cells) * w_cells
            + _safe_norm(df_to_optimize.get('reroll_shards_earned', pd.Series([0.0])), denom_shards) * w_shards
        ) * 100

    # Convert required_tiers to list of integers
    required_tiers_int = None
    if required_tiers and len(required_tiers) > 0:
        required_tiers_int = [int(t) for t in required_tiers]
    
    # Create optimizer figure
    daytime_hours_val = int(daytime_hours or 16)
    nighttime_max_runs_val = int(nighttime_max_runs or 1)
    current_days_val = int(current_days or 3)
    tournament_runs_val = int(tournament_runs or 2)
    tournament_tier_val = int(tournament_tier or 12)
    
    optimizer_graph, opt_warning = optimize_figure(
        df_to_optimize,
        daytime_hours_val,
        time_series_df,
        all_runs_time_series_df,
        current_days=current_days_val,
        nighttime_max_runs=nighttime_max_runs_val,
        required_tiers=required_tiers_int,
        tournament_runs=tournament_runs_val,
        tournament_tier=tournament_tier_val
    )
    
    # Create cluster review figure from clustered data
    weighted_view = bool(cluster_review_weighted and 'weighted' in cluster_review_weighted)
    cluster_review_graph = cluster_review_figure(cluster_df, weighted=weighted_view)
    
    # Format warning if present
    optimizer_warning = None
    if opt_warning:
        optimizer_warning = html.Div(
            [
                html.Strong('⚠️ Optimization Warning: '),
                opt_warning
            ],
            style={'color': '#f97316', 'background': '#222', 'padding': '1rem', 'borderRadius': '6px'}
        )
    
    return optimizer_graph, cluster_review_graph, tier_options, tier_options, optimizer_warning, None
