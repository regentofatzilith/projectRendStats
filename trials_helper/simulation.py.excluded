     Output('ovr-bh-cd', 'value'), Output('ovr-bh-up', 'value'), Output('ovr-bh-bonus', 'value'), Output('ovr-bh-size', 'value'),
     Output('ovr-sp-dmg', 'value'), Output('ovr-sp-angle', 'value'), Output('ovr-sp-qty', 'value'),
