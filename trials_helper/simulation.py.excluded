)
def reset_overrides(n_clicks):
    """Clear all override inputs to reset to current effective parameters."""
    # Return default values for all override fields
    return DEFAULT_OVERRIDE_VALUES



# New callback: planner activation line
@callback(
    Output('planner-activation-line', 'children'),
    [Input('planner-components-store', 'data')]
)
def update_planner_activation_line(components_data):
    # Show average activation time, or 'Permanent' if 100% uptime
    if not components_data:
        return "average activation: --.-s"
    # Try to get uptime percentage and average activation from components
    uw_stats = components_data.get('uw_permanence', {})
    # Aggregate across all UWs, or pick one (e.g., Golden Tower)
    # For now, show the best (highest uptime) UW
    best_uw = None
    best_uptime = 0
    for uw, stats in uw_stats.items():
        if stats.get('uptime_pct', 0) > best_uptime:
            best_uptime = stats.get('uptime_pct', 0)
            best_uw = uw
    if best_uw and best_uptime >= 99.9:
        return "average activation: Permanent"
    # Otherwise, show average activation time for best UW
    avg_activation = uw_stats.get(best_uw, {}).get('avg_activation', None)
    if avg_activation is not None:
        return f"average activation: {avg_activation:.1f}s"
    return "average activation: --.-s"
